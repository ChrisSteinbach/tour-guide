{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "spherical-delaunay": ["./lib/spherical-delaunay/src/index.ts"]
    },
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": ["src", "lib/spherical-delaunay/src"]
}
